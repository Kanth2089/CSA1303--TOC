#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int len, i = 0;
    int zeros = 0, ones = 0;
    int valid = 1;

    printf("Enter a string over {0,1}: ");
    scanf("%s", str);

    len = strlen(str);

    /* Count consecutive 0's */
    while (i < len && str[i] == '0') {
        zeros++;
        i++;
    }

    /* Count consecutive 1's */
    while (i < len && str[i] == '1') {
        ones++;
        i++;
    }

    /* No other symbols should occur */
    if (i != len)
        valid = 0;

    /* Equal number of 0's and 1's */
    if (zeros != ones)
        valid = 0;

    if (valid)
        printf("Accepted\n");
    else
        printf("Rejected\n");

    return 0;
}
