#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int i, len, state = 0;

    printf("Enter a string over {a,b}: ");
    scanf("%s", str);

    len = strlen(str);

    /* NFA accepts if first symbol is b and last symbol is a */
    if (len >= 2 && str[0] == 'b' && str[len - 1] == 'a')
        state = 1;

    if (state == 1)
        printf("Accepted\n");
    else
        printf("Rejected\n");

    return 0;
}
