#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int state = 0, i;

    printf("Enter a string over {0,1}: ");
    scanf("%s", str);

    for (i = 0; str[i] != '\0'; i++) {
        if (i == 0) {
            if (str[i] == '0')
                state = 1;
            else {
                state = 0;
                break;
            }
        } else {
            if (str[i] == '1')
                state = 2;
            else if (str[i] == '0')
                state = 1;
            else {
                state = 0;
                break;
            }
        }
    }

    if (state == 2)
        printf("Accepted\n");
    else
        printf("Rejected\n");

    return 0;
}
