#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int i, len, valid = 1, found = 0;

    printf("Enter a string over {0,1}: ");
    scanf("%s", str);

    len = strlen(str);

    /* Check whether all characters are 0 or 1 */
    for (i = 0; i < len; i++) {
        if (str[i] != '0' && str[i] != '1') {
            valid = 0;
            break;
        }
    }

    /* Search for substring 101 */
    if (valid) {
        for (i = 0; i <= len - 3; i++) {
            if (str[i] == '1' &&
                str[i + 1] == '0' &&
                str[i + 2] == '1') {
                found = 1;
                break;
            }
        }
    }

    if (valid && found)
        printf("Accepted\n");
    else
        printf("Rejected\n");

    return 0;
}
