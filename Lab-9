#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int len;

    printf("Enter a string over {o,1}: ");
    scanf("%s", str);

    len = strlen(str);

    if (len >= 2 && str[0] == 'o' && str[len - 1] == '1')
        printf("Accepted\n");
    else
        printf("Rejected\n");

    return 0;
}
